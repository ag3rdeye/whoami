---
import type { Writeup } from '@/lib/content';

interface Props {
  entry: Writeup;
}
const { entry } = Astro.props;
const { data } = entry;
---

<a
  href={`/writeup/${entry.id}`}
  class="group rise block border-t border-fg/25 py-8"
>
  <div class="label flex flex-wrap items-center gap-x-4 uppercase text-muted">
    <span class="text-accent">{data.category}</span>
    <span>
      {data.publishDate.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' })}
    </span>
  </div>
  <h3 class="mt-2 text-[clamp(2.5rem,5vw,4.5rem)] leading-none transition-colors group-hover:text-accent">{data.title}</h3>
  <p class="mt-3 max-w-3xl text-xl leading-snug text-muted">{data.description}</p>
</a>
