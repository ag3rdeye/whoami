---
import { period as formatPeriod, type Experience } from '@/lib/content';

interface Props {
  items: Experience[];
}
const { items } = Astro.props;
---

<ol class="relative">
  {/* The line draws itself as you scroll */}
  <span class="line absolute bottom-0 top-0 left-[7px] w-px md:left-1/2" aria-hidden="true">
    <i></i>
  </span>

  {
    items.map((entry, i) => {
      const { data } = entry;
      const left = i % 2 === 0;
      const period = formatPeriod(data.start, data.end, data.current);
      return (
        <li class="rise relative mb-16 last:mb-0 md:mb-24 md:grid md:grid-cols-2 md:gap-x-16">
          <span
            class="absolute top-3 left-0 z-10 size-3.5 bg-accent md:left-1/2 md:-translate-x-1/2"
            aria-hidden="true"
          />
          {/* Connector from the line to the entry */}
          <span
            class:list={[
              'absolute top-[1.1rem] hidden h-px w-12 bg-accent/60 md:block',
              left ? 'right-1/2' : 'left-1/2',
            ]}
            aria-hidden="true"
          />
          <div class:list={['pl-8 md:pl-0', left ? 'md:col-start-1 md:pr-12' : 'md:col-start-2 md:pl-12']}>
            {period && <p class="label uppercase text-accent">{period}</p>}
            <h3 class="mt-2 text-4xl leading-none sm:text-5xl">{data.position}</h3>
            <p class="mt-2 text-xl">{data.org}</p>
            {data.location && <p class="label mt-1 text-muted">{data.location}</p>}
            {data.description && <p class="mt-3 leading-snug text-muted">{data.description}</p>}
            {data.responsibilities.length > 0 && (
              <ul class="mt-5 space-y-2.5 leading-snug text-fg/80">
                {data.responsibilities.map((r) => (
                  <li class="border-t border-border pt-2.5">{r}</li>
                ))}
              </ul>
            )}
            {data.tech.length > 0 && (
              <p class="label mt-5 leading-relaxed text-muted">{data.tech.join(' / ')}</p>
            )}
          </div>
        </li>
      );
    })
  }
</ol>

<style>
  .line {
    background: var(--border);
  }
  .line i {
    display: block;
    width: 100%;
    height: 100%;
    background: var(--accent);
    transform-origin: top;
  }
  @supports (animation-timeline: view()) {
    .line i {
      animation: draw linear both;
      animation-timeline: view();
      animation-range: entry 20% exit 60%;
    }
    @keyframes draw {
      from {
        transform: scaleY(0);
      }
    }
  }
</style>
