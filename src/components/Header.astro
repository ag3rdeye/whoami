---
import site from '@/data/site.json';
import ThemeToggle from './ThemeToggle.astro';
import { Icon } from 'astro-icon/components';

const path = Astro.url.pathname;
const isActive = (href: string) => path === href || (href !== '/' && path.startsWith(href));
---

<header
  class:list={[
    'sticky top-0 z-40',
  ]}
>
  <div class="mx-auto flex h-16 max-w-[1500px] items-center justify-between px-5 sm:px-10">
    <a href="/" class="font-heading text-xl uppercase tracking-wide">{site.title}</a>

    <nav class="hidden items-center gap-6 md:flex" aria-label="Primary">
      {
        site.nav.map((item) => (
          <a
            href={item.href}
            class:list={[
              'label uppercase transition-colors hover:text-accent',
              isActive(item.href) ? 'text-accent' : 'text-fg/70',
            ]}
            aria-current={isActive(item.href) ? 'page' : undefined}
          >
            {item.label}
          </a>
        ))
      }
    </nav>

    <div class="flex items-center gap-2">
      <button
        id="shell-open"
        type="button"
        class="inline-flex h-9 items-center gap-2 px-2 text-muted transition-colors hover:text-accent"
        aria-label="Open shell"
      >
        <Icon name="lucide:terminal" class="size-4" />
        <kbd class="hidden font-mono text-xs lg:inline">`</kbd>
      </button>
      <ThemeToggle />
      <button
        id="menu-toggle"
        type="button"
        class="grid size-9 place-items-center text-muted md:hidden"
        aria-label="Toggle menu"
        aria-expanded="false"
      >
        <Icon name="lucide:menu" class="size-4" />
      </button>
    </div>
  </div>

  <nav
    id="mobile-nav"
    class="hidden bg-bg px-5 py-3 md:hidden"
    aria-label="Mobile"
  >
    {
      site.nav.map((item) => (
        <a href={item.href} class="block py-2 font-heading text-2xl uppercase hover:text-accent">
          {item.label}
        </a>
      ))
    }
  </nav>
</header>

