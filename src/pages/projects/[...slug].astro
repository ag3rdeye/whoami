---
import { render } from 'astro:content';
import ArticleLayout from '@/layouts/ArticleLayout.astro';
import { Icon } from 'astro-icon/components';
import { getProjects } from '@/lib/content';

export async function getStaticPaths() {
  const items = await getProjects();
  return items.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { data } = entry;
const { Content, headings } = await render(entry);

const meta = [
  { label: 'Category', value: data.category },
  { label: 'Status', value: data.projectStatus },
  data.startDate && { label: 'Started', value: data.startDate.toLocaleDateString('en-US') },
  data.updated && { label: 'Updated', value: data.updated.toLocaleDateString('en-US') },
].filter(Boolean) as { label: string; value: string }[];
---

<ArticleLayout
  title={data.name}
  description={data.description}
  meta={meta}
  headings={headings}
  glyph={data.name}
>
  <div class="mb-6 flex flex-wrap gap-3 not-prose">
    {
      data.repo && (
        <a
          href={data.repo}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 label text-accent underline underline-offset-4"
        >
          <Icon name="lucide:github" class="size-4" /> Repository
        </a>
      )
    }
    {
      data.demo && (
        <a
          href={data.demo}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 label text-accent underline underline-offset-4"
        >
          <Icon name="lucide:external-link" class="size-4" /> Live demo
        </a>
      )
    }
  </div>

  {data.featuredImage && <img src={data.featuredImage} alt="" loading="lazy" />}
  <Content />
  {data.screenshots.map((shot) => <img src={shot.src} alt={shot.alt} loading="lazy" />)}

  {
    data.features.length > 0 && (
      <section class="mt-10">
        <h2>Key features</h2>
        <ul>
          {data.features.map((f) => (
            <li>{f}</li>
          ))}
        </ul>
      </section>
    )
  }

  {
    data.tech.length > 0 && (
      <section class="mt-10 not-prose">
        <h2 class="text-3xl">Technologies</h2>
        <ul class="mt-3 flex flex-wrap gap-2">
          {data.tech.map((t) => (
            <li class="label text-muted">
              {t}
            </li>
          ))}
        </ul>
      </section>
    )
  }
</ArticleLayout>
